.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/

# LaTeX build output (regenerated by latexmk; Overleaf does not track these)
main.aux
main.bbl
main.blg
main.fdb_latexmk
main.fls
main.log
main.out
main.pdf

# figures/: track only the numbered paper figures (fig1.png, fig3_distance_spectra.pdf, ...).
# Everything else in there is scratch output and stays local.
figures/*
!figures/fig[0-9]*
